---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found">
  <section class="min-h-[60vh] flex items-center justify-center text-center">
    <div class="section-container">
      <h1 class="text-9xl font-black text-brand-primary/20 mb-4">404</h1>
      <p class="text-2xl font-bold mb-8">Trang không tồn tại hoặc đã bị di chuyển.</p>
      <a href="/vi/" class="btn-primary inline-block">
        Quay về trang chủ
      </a>
    </div>
  </section>
</BaseLayout>
