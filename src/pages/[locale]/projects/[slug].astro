---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => {
    const [locale, slug] = project.id.split('/');
    return {
      params: { locale, slug: slug.replace('.md', '') },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { locale } = Astro.params;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title}>
  <section class="py-24">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12" data-aos="fade-up">
          <a href={`/${locale}/projects`} class="text-brand-primary font-bold mb-8 inline-block hover:underline">
            ← Quay lại
          </a>
          <h1 class="text-4xl md:text-5xl font-black mb-6">{project.data.title}</h1>
          
          <div class="flex flex-wrap gap-3 mb-8">
            {project.data.technologies.map(tech => (
              <span class="bg-gray-100 text-gray-700 px-4 py-1.5 rounded-full text-sm font-bold">
                {tech}
              </span>
            ))}
          </div>

          <div class="aspect-video rounded-3xl overflow-hidden bg-gray-100 mb-12 shadow-xl">
            {project.data.thumbnail ? (
              <img src={project.data.thumbnail} alt={project.data.title} class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full bg-gradient-primary"></div>
            )}
          </div>
        </div>

        <div class="prose prose-lg max-w-none" data-aos="fade-up">
          <Content />
        </div>

        <div class="mt-16 flex gap-4" data-aos="fade-up">
          {project.data.demoUrl && (
            <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Live Demo
            </a>
          )}
          {project.data.githubUrl && (
            <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="bg-gray-900 text-white px-6 py-3 rounded-lg font-medium transition-all hover:bg-black">
              GitHub Repo
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
