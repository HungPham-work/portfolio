---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { locale: 'vi' } },
    { params: { locale: 'en' } },
  ];
}

const { locale } = Astro.params;
const t = useTranslations(locale as any);

const aboutData = await getEntry('about', locale as string);

if (!aboutData) {
  throw new Error(`About data not found for locale: ${locale}`);
}

const { Content } = await render(aboutData);
---

<BaseLayout title={t('nav.about')}>
  <section class="py-32 overflow-hidden relative">
    <!-- Decorative background -->
    <div class="absolute top-0 left-0 w-full h-full -z-10 opacity-5">
      <svg width="100%" height="100%" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <circle cx="200" cy="200" r="150" fill="#1E6A6E" />
        <circle cx="800" cy="800" r="200" fill="#DB4524" />
      </svg>
    </div>

    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-24 items-start">
        <div class="relative order-2 lg:order-1" data-aos="fade-right">
          <div class="aspect-[4/5] rounded-[48px] overflow-hidden bg-brand-surface p-1.5 hanging-shadow">
            <div class="w-full h-full bg-white rounded-[42px] overflow-hidden flex items-center justify-center">
              {aboutData.data.avatar ? (
                <img src={aboutData.data.avatar} alt="Avatar" class="w-full h-full object-cover" />
              ) : (
                <div class="text-9xl grayscale opacity-50">👨‍💻</div>
              )}
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-8 -right-8 glass-card p-6 rounded-3xl animate-float">
            <p class="text-3xl font-black text-brand-primary">3+</p>
            <p class="text-xs font-bold uppercase tracking-widest text-brand-text/50">Years Exp.</p>
          </div>
        </div>

        <div class="order-1 lg:order-2" data-aos="fade-left">
          <p class="badge-teal mb-6 inline-block">Professional Story</p>
          <h1 class="text-5xl md:text-6xl font-black mb-10 text-brand-text leading-tight">
            {aboutData.data.title}
          </h1>
          
          <div class="prose prose-lg prose-brand-text max-w-none mb-16">
            <p class="text-2xl font-bold text-brand-text mb-8 leading-relaxed">
              {aboutData.data.bio}
            </p>
            <div class="text-brand-text/70 leading-relaxed space-y-6">
              <Content />
            </div>
          </div>
          
          <div class="grid sm:grid-cols-2 gap-8">
            {aboutData.data.skills.map(skillGroup => {
              const [group, skills] = skillGroup.split(': ');
              return (
                <div class="p-8 bg-white rounded-3xl border border-brand-text/5 hanging-shadow transition-transform hover:-translate-y-1">
                  <h3 class="font-black text-brand-primary mb-4 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
                    {group}
                  </h3>
                  <p class="text-brand-text/60 text-sm font-medium leading-loose">{skills}</p>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
