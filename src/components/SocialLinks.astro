---
const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/hungpq', icon: 'github' },
  { name: 'LinkedIn', href: 'https://linkedin.com/in/hungpq', icon: 'linkedin' },
  { name: 'Email', href: 'mailto:hung@example.com', icon: 'mail' },
];
---

<div class="flex items-center gap-6">
  {socialLinks.map(link => (
    <a 
      href={link.href} 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-brand-text/40 hover:text-brand-primary transition-colors flex items-center gap-2 font-bold text-sm"
      title={link.name}
    >
      <span class="w-8 h-8 rounded-full bg-brand-surface flex items-center justify-center transition-transform hover:scale-110">
        <span class="sr-only">{link.name}</span>
        {/* Simplified Icons using text for now */}
        <span class="text-[10px]">{link.name.charAt(0)}</span>
      </span>
      <span class="hidden sm:inline">{link.name}</span>
    </a>
  ))}
</div>
