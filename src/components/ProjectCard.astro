---
interface Props {
  title: string;
  description: string;
  thumbnail?: string;
  technologies: string[];
  slug: string;
  lang: string;
}

const { title, description, thumbnail, technologies, slug, lang } = Astro.props;
---

<div class="group relative bg-white rounded-[32px] overflow-hidden border border-brand-text/5 transition-all duration-500 hover:hanging-shadow hover:-translate-y-2" data-aos="fade-up">
  <!-- Card Header Image -->
  <div class="aspect-[4/3] overflow-hidden bg-brand-surface/30 relative">
    {thumbnail ? (
      <img src={thumbnail} alt={title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-brand-text/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      </div>
    )}
    
    <!-- Organic Wave Overlay (Mimicking CareerPod) -->
    <div class="absolute bottom-0 left-0 w-full h-12 bg-white translate-y-1">
      <svg viewBox="0 0 500 150" preserveAspectRatio="none" class="w-full h-full fill-white">
        <path d="M-10.44,66.61 C149.99,150.00 349.20,-49.33 511.00,66.61 L500.00,150.00 L0.00,150.00 Z"></path>
      </svg>
    </div>

    <!-- Featured Badge -->
    <div class="absolute top-4 left-4">
      <span class="badge-teal">Case Study</span>
    </div>
  </div>
  
  <div class="p-8 pt-4 relative">
    <div class="flex flex-wrap gap-2 mb-6">
      {technologies.map(tech => (
        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-primary bg-brand-primary/5 px-2 py-1 rounded">
          {tech}
        </span>
      ))}
    </div>
    
    <h3 class="text-2xl font-black mb-4 group-hover:text-brand-primary transition-colors leading-tight">
      <a href={`/${lang}/projects/${slug}`}>
        {title}
      </a>
    </h3>
    
    <p class="text-brand-text/60 text-sm line-clamp-2 leading-relaxed mb-8">
      {description}
    </p>

    <a href={`/${lang}/projects/${slug}`} class="text-sm font-bold text-brand-text flex items-center gap-2 group/link">
      Xem chi tiết
      <span class="w-6 h-6 rounded-full bg-brand-surface flex items-center justify-center transition-transform group-hover/link:translate-x-1">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.5 9L7.5 6L4.5 3" stroke="#593B34" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</div>
