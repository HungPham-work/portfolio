---
interface Props {
  greeting: string;
  name: string;
  tagline: string;
  cta: string;
  ctaLink: string;
}

const { greeting, name, tagline, cta, ctaLink } = Astro.props;
---

<section class="hero relative w-full h-screen min-h-[850px] bg-[#F3E4D2] overflow-hidden">

  <!-- Lighting (z-1) -->
  <div class="absolute top-0 left-0 w-full h-full opacity-50 z-[1] mix-blend-overlay pointer-events-none flex">
    <div class="w-1/2 h-full">
      <img src="/images/lighting_sp.png" alt="" class="w-full h-full object-cover">
    </div>
    <div class="w-1/2 h-full">
      <img src="/images/lighting_sp.png" alt="" class="w-full h-full object-cover transform scale-x-[-1]">
    </div>
  </div>

  <!-- Text content (z-20, absolute top-left) -->
  <div class="absolute top-24 left-6 md:left-12 z-[20] max-w-md pointer-events-auto lg:max-w-lg">
    <h1 class="text-4xl md:text-6xl font-black mb-6 leading-[1.1] text-[#593B34] tracking-tighter drop-shadow-sm">
      {name}
    </h1>
    <p class="text-lg md:text-xl text-[#593B34]/80 mb-10 leading-loose font-bold">
      {tagline}
    </p>
    <div class="flex flex-wrap gap-6">
      <a href={ctaLink} class="btn-premium !bg-[#1E6A6E] !rounded-full !py-4 !px-8 shadow-xl shadow-[#1E6A6E]/20 hover:scale-105 transition-all duration-300">
        <span class="font-black tracking-widest">{cta}</span>
        <span class="w-8 h-8 rounded-full bg-white flex items-center justify-center ml-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H11M11 6L6 1M11 6L6 11" stroke="#1E6A6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <!-- Character (z-4, bottom-0, center) -->
  <div class="absolute left-1/2 -translate-x-1/2 bottom-0 z-[4] pointer-events-none">
    <div class="staff_a relative w-[350px] md:w-[450px]" style="height: 80vh; max-height: 850px;">
      <img src="/images/top_person1_1.png" alt="" class="type1 absolute inset-0 w-full h-full object-contain object-bottom transition-opacity duration-500 drop-shadow-[0_40px_60px_rgba(89,59,52,0.4)]">
      <img src="/images/top_person1_1.png" alt="" class="type2 absolute inset-0 w-full h-full object-contain object-bottom transition-opacity duration-500 opacity-0 drop-shadow-[0_40px_60px_rgba(89,59,52,0.4)]" style="transform: scaleX(-1);">
    </div>
  </div>

  <!-- Fan cards (z-10, trước mặt bàn) -->
  <div class="hero__fan" id="heroFan" style="z-index: 10;">
    <!-- Card 1 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#1E6A6E"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#1E6A6E]">PROJ 1</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#1E6A6E] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Dự án Nổi Bật</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Nền tảng Thương mại Điện tử Đa kênh</h3>
        </div>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#DB4524"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#DB4524]">PROJ 2</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#DB4524] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Thiết kế UI/UX</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Ứng dụng Quản lý Tự động hóa</h3>
        </div>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#1E6A6E"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#1E6A6E]">PROJ 3</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#1E6A6E] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Phát triển Web</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Hệ thống Đặt lịch Trực tuyến</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="fan-navi">
    <div class="fan-navi__prev" id="fanPrev">
      <div class="icn">
        <svg viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 4L15 4" stroke="#F7EFE6" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M4 7C3.20435 7 2.44129 6.68393 1.87868 6.12132C1.31607 5.55871 1 4.79565 1 4C1 3.20435 1.31607 2.44129 1.87868 1.87868C2.44129 1.31607 3.20435 1 4 1" stroke="#F7EFE6" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
    <div class="fan-navi__next" id="fanNext">
      <div class="icn">
        <svg viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 4L15 4" stroke="#F7EFE6" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M4 7C3.20435 7 2.44129 6.68393 1.87868 6.12132C1.31607 5.55871 1 4.79565 1 4C1 3.20435 1.31607 2.44129 1.87868 1.87868C2.44129 1.31607 3.20435 1 4 1" stroke="#F7EFE6" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Table: chỉ hiện mặt bàn, clip phần chân (z-6) -->
  <div class="absolute left-0 w-full z-[6] pointer-events-none"
       style="bottom: -20px;">
    <img src="/images/table_sp.png" 
         class="w-full block"
         style="height: auto; max-height: 35vh;">
  </div>

  <!-- Dải nâu nhạt sát đáy (z-6) -->
  <div class="absolute bottom-0 left-0 w-full h-[80px] bg-[#A77D53] z-[6]"></div>

  <!-- Speech bubble (z-20) -->
  <div class="hero__bubble hidden md:block z-[20]">
    <div class="bubble bg-white/60 backdrop-blur-xl rounded-2xl rounded-bl-none p-5 border border-white/60 shadow-[0_10px_20px_rgba(89,59,52,0.15)] relative">
      <p class="text-[#593B34] text-sm font-black tracking-widest leading-relaxed bubble-text-1 transition-opacity duration-500 opacity-100">
        Chào mừng bạn đến với không gian của tôi! ✨
      </p>
      <p class="text-[#593B34] text-sm font-black tracking-widest leading-relaxed bubble-text-2 transition-opacity duration-500 opacity-0 absolute inset-0 p-5 pointer-events-none">
        Bạn đã sẵn sàng để xây dựng dự án mới?
      </p>
      <!-- Triangle Tail -->
      <svg class="absolute -bottom-3 left-8" width="24" height="16" viewBox="0 0 24 16" fill="none">
        <path d="M0 0 L12 16 L24 0 Z" fill="rgba(255,255,255,0.6)"/>
      </svg>
    </div>
  </div>

</section>

<style>
  :global(.hero) {
    overflow: hidden;
  }

  :global(.hero__bubble) {
    position: absolute;
    top: 15%;
    left: 50%;
    margin-left: 140px; 
    transform: rotate(-3deg);
    max-width: 280px;
  }

  :global(.hero__fan) {
    position: absolute;
    bottom: 140px; 
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 500px;
    touch-action: none;
  }

  :global(.fan-card) {
    position: absolute;
    width: 240px;
    height: 330px;
    left: 50%;
    bottom: 0;
    margin-left: -120px;
    transform-origin: 50% 320%;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    cursor: pointer;
    will-change: transform;
    user-select: none;
  }

  :global(.fan-card .card) {
    width: 100%;
    height: 100%;
  }

  :global(.fan-navi) {
    position: absolute;
    bottom: 148px; 
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 12;
    pointer-events: none;
  }

  :global(.fan-navi__prev),
  :global(.fan-navi__next) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #593B34;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.2s, transform 0.2s;
  }

  :global(.fan-navi__prev:hover),
  :global(.fan-navi__next:hover) {
    opacity: 0.85;
    transform: scale(1.08);
  }

  :global(.fan-navi__prev .icn),
  :global(.fan-navi__next .icn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 8px;
  }

  :global(.fan-navi__prev .icn svg) {
    transform: scaleX(-1);
  }

  :global(.fan-navi__next .icn svg) {
    transform: scaleX(1);
  }

  @media (max-width: 1023px) {
     .hero {
        min-height: 1400px;
     }
  }

  @media (max-width: 767px) {
    .hero {
        min-height: 1200px;
    }
    :global(.fan-card) {
      width: 200px;
      height: 280px;
      margin-left: -100px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const fanEl = document.getElementById('heroFan');
  if (!fanEl) return;

  const cards = Array.from(fanEl.querySelectorAll('.fan-card')) as HTMLElement[];
  if (cards.length === 0) return;

  cards.forEach(el => { el.style.transformOrigin = '50% 320%'; });

  const N = cards.length;
  const SPREAD = 38;
  const BASE_ANGLES = cards.map((_, i) => {
    const mid = (N - 1) / 2;
    return (i - mid) * (SPREAD / (N - 1));
  });

  let currentOffset = 0;
  let targetOffset = 0;
  let raf: number | null = null;

  function getActiveIdx(offset: number) {
    let best = 0, bestDist = Infinity;
    BASE_ANGLES.forEach((a, i) => {
      const dist = Math.abs(a + offset);
      if (dist < bestDist) { bestDist = dist; best = i; }
    });
    return best;
  }

  function applyLayout(offset: number) {
    const active = getActiveIdx(offset);
    cards.forEach((el, i) => {
      const angle = BASE_ANGLES[i] + offset;
      const scale = 1 - Math.abs(angle) * 0.004;
      el.style.transform = `rotate(${angle}deg) scale(${scale})`;
      el.style.zIndex = (N - Math.abs(i - active)).toString();
    });
  }

  function animateTo() {
    if (raf) cancelAnimationFrame(raf);
    function tick() {
      currentOffset += (targetOffset - currentOffset) * 0.12;
      applyLayout(currentOffset);
      if (Math.abs(currentOffset - targetOffset) > 0.01) {
        raf = requestAnimationFrame(tick);
      } else {
        currentOffset = targetOffset;
        applyLayout(currentOffset);
      }
    }
    tick();
  }

  cards.forEach((el, i) => {
    el.addEventListener('click', () => {
      targetOffset = -BASE_ANGLES[i];
      animateTo();
    });
  });

  document.getElementById('fanPrev')?.addEventListener('click', () => {
    const cur = getActiveIdx(currentOffset);
    const next = Math.max(0, cur - 1);
    targetOffset = -BASE_ANGLES[next];
    animateTo();
  });

  document.getElementById('fanNext')?.addEventListener('click', () => {
    const cur = getActiveIdx(currentOffset);
    const next = Math.min(N - 1, cur + 1);
    targetOffset = -BASE_ANGLES[next];
    animateTo();
  });

  let pointerStartX = 0, pointerStartOffset = 0, dragging = false;

  fanEl.addEventListener('pointerdown', e => {
    dragging = true;
    pointerStartX = e.clientX;
    pointerStartOffset = currentOffset;
    if (raf) cancelAnimationFrame(raf);
    fanEl.setPointerCapture(e.pointerId);
  });

  fanEl.addEventListener('pointermove', e => {
    if (!dragging) return;
    currentOffset = pointerStartOffset + (e.clientX - pointerStartX) * 0.15;
    targetOffset = currentOffset;
    applyLayout(currentOffset);
  });

  fanEl.addEventListener('pointerup', () => {
    if (!dragging) return;
    dragging = false;
    targetOffset = -BASE_ANGLES[getActiveIdx(currentOffset)];
    animateTo();
  });

  applyLayout(0);

  // --- 2. Bubble text crossfade ---
  const text1 = document.querySelector('.bubble-text-1') as HTMLElement;
  const text2 = document.querySelector('.bubble-text-2') as HTMLElement;
  let isText1 = true;

  if (text1 && text2) {
    setInterval(() => {
      isText1 = !isText1;
      text1.style.opacity = isText1 ? '1' : '0';
      text2.style.opacity = isText1 ? '0' : '1';
    }, 4000);
  }
});
</script>