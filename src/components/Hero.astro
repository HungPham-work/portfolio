---
interface Props {
  greeting: string;
  name: string;
  tagline: string;
  cta: string;
  ctaLink: string;
}

const { greeting, name, tagline, cta, ctaLink } = Astro.props;
---

<section class="hero relative w-full h-screen min-h-[850px] overflow-hidden"
         style="background-color: rgba(243, 228, 210, 0.9);">

  <!-- Lighting (z-1) -->
  <div class="absolute top-0 left-0 z-[1] pointer-events-none opacity-80">
    <img src="/images/highlight_left_sp.png" alt="">
  </div>

  <div class="absolute top-0 right-0 z-[1] pointer-events-none opacity-80">
    <img src="/images/highlight_right_sp.png" alt="">
  </div>

  <!-- Text content (z-20, absolute top-left) -->
  <div class="absolute top-24 left-6 md:left-12 z-[20] max-w-md pointer-events-auto lg:max-w-lg">
    <h1 class="text-4xl md:text-6xl font-black mb-6 leading-[1.1] text-[#593B34] tracking-tighter drop-shadow-sm">
      {name}
    </h1>
    <p class="text-lg md:text-xl text-[#593B34]/80 mb-10 leading-loose font-bold">
      {tagline}
    </p>
    <div class="flex flex-wrap gap-6">
      <a href={ctaLink} class="btn-premium !bg-[#1E6A6E] !rounded-full !py-4 !px-8 shadow-xl shadow-[#1E6A6E]/20 hover:scale-105 transition-all duration-300">
        <span class="font-black tracking-widest">{cta}</span>
        <span class="w-8 h-8 rounded-full bg-white flex items-center justify-center ml-2">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H11M11 6L6 1M11 6L6 11" stroke="#1E6A6E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>

  <!-- Character (z-4, bottom-0, center) -->
  <div class="absolute left-1/2 -translate-x-1/2 bottom-0 z-[0] pointer-events-none">
    <div class="staff_a relative w-[350px] md:w-[450px]" style="height: 95vh; max-height: 850px;">
      <img src="/images/top_person3_1.png" alt="" class="type1 absolute inset-0 w-full h-full object-contain object-bottom transition-opacity duration-500 drop-shadow-[0_40px_60px_rgba(89,59,52,0.4)]">
      <img src="/images/top_person3_2.png" alt="" class="type2 absolute inset-0 w-full h-full object-contain object-bottom transition-opacity duration-500 opacity-0 drop-shadow-[0_40px_60px_rgba(89,59,52,0.4)]">
    </div>
  </div>

  <!-- Fan cards (z-10, trước mặt bàn) -->
  <div class="hero__fan" id="heroFan" style="z-index: 10;">
    <!-- Card 1 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#1E6A6E"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#1E6A6E]">PROJ 1</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#1E6A6E] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Dự án Nổi Bật</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Nền tảng Thương mại Điện tử Đa kênh</h3>
        </div>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#DB4524"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#DB4524]">PROJ 2</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#DB4524] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Thiết kế UI/UX</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Ứng dụng Quản lý Tự động hóa</h3>
        </div>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="fan-card">
      <div class="card bg-white rounded-[24px] shadow-[0_20px_40px_-15px_rgba(89,59,52,0.2)] border border-[#593B34]/5 overflow-hidden flex flex-col h-full">
        <div class="card__image relative h-[180px] bg-[#FAF8F6]">
          <div class="absolute inset-0 opacity-10">
            <svg viewBox="0 0 320 220" preserveAspectRatio="none" class="w-full h-full">
              <path d="M0,150 Q160,50 320,150 V220 H0 Z" fill="#1E6A6E"/>
            </svg>
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-24 h-24 bg-white/60 backdrop-blur-md rounded-2xl border border-white shadow-lg flex items-center justify-center rotate-[-5deg]">
              <span class="text-xl font-black text-[#1E6A6E]">PROJ 3</span>
            </div>
          </div>
        </div>
        <div class="card__body p-6 bg-white flex-grow flex flex-col border-t border-[#F3E4D2]">
          <span class="badge bg-[#1E6A6E] text-white text-[10px] font-black tracking-widest px-3 py-1 rounded w-max uppercase">Phát triển Web</span>
          <h3 class="mt-4 text-xl font-black text-[#593B34] leading-tight">Hệ thống Đặt lịch Trực tuyến</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="fan-navi">
    <div class="fan-navi__prev" id="fanPrev">
      <div class="icn">
        <svg viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 4L15 4" stroke="#F7EFE6" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M4 7C3.20435 7 2.44129 6.68393 1.87868 6.12132C1.31607 5.55871 1 4.79565 1 4C1 3.20435 1.31607 2.44129 1.87868 1.87868C2.44129 1.31607 3.20435 1 4 1" stroke="#F7EFE6" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
    <div class="fan-navi__next" id="fanNext">
      <div class="icn">
        <svg viewBox="0 0 16 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 4L15 4" stroke="#F7EFE6" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M4 7C3.20435 7 2.44129 6.68393 1.87868 6.12132C1.31607 5.55871 1 4.79565 1 4C1 3.20435 1.31607 2.44129 1.87868 1.87868C2.44129 1.31607 3.20435 1 4 1" stroke="#F7EFE6" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Isolated layer cho table + decorations -->
  <div style="isolation: isolate; position: absolute; inset: 0; pointer-events: none;">

    <!-- Green plants -->
    <div class="absolute z-[7]" style="bottom: calc(35vh - 30px); left: 0;">
      <img src="/images/green_top_left_sp.png" alt="">
    </div>
    <div class="absolute z-[7]" style="bottom: calc(35vh - 55px); right: -180px;">
      <img src="/images/green_top_right_sp.png" alt="">
    </div>
    <div class="absolute z-[7]" style="bottom: calc(35vh / 2); left: 0;">
      <img src="/images/green_mid_left_sp.png" alt="">
    </div>
    <div class="absolute z-[7]" style="bottom: calc(35vh / 2 - 30px); right: 0;">
      <img src="/images/green_mid_right_sp.png" alt="">
    </div>
    <div class="absolute z-[7]" style="bottom: -200px; left: 0;">
      <img src="/images/green_btm_left_sp.png" alt="">
    </div>
    <div class="absolute z-[7]" style="bottom: -50px; right: 0;">
      <img src="/images/green_btm_right_sp.png" alt="">
    </div>

    <!-- Counter -->
    <div class="absolute z-[6]" style="bottom: 100px; right: 0; width: 500px;">
      <img src="/images/counter.png" class="w-full h-auto block" alt="">
    </div>

    <!-- Table -->
    <div class="absolute left-0 w-full z-[6]" style="bottom: -50px;">
      <img src="/images/table_sp.png" class="w-full block" style="height: auto; max-height: 35vh;">
      <!-- Gradient fade xuống brown -->
    <div class="absolute bottom-0 left-0 w-full h-[60px]" 
       style="background: linear-gradient(to bottom, transparent, #A77D53);"></div>
    </div>

    <!-- Brown strip -->
    <div class="absolute bottom-0 left-0 w-full h-[80px] bg-[#A77D53] z-[6]"></div>

  </div>

  <!-- Speech bubble (z-20) -->
  <div class="hero__bubble hidden md:block z-[20]">
    <div class="bubble bg-white/60 backdrop-blur-xl rounded-2xl rounded-bl-none p-5 border border-white/60 shadow-[0_10px_20px_rgba(89,59,52,0.15)] relative">
      <p class="text-[#593B34] text-sm font-black tracking-widest leading-relaxed bubble-text-1 transition-opacity duration-500 opacity-100">
        Chào mừng bạn đến với không gian của tôi! ✨
      </p>
      <p class="text-[#593B34] text-sm font-black tracking-widest leading-relaxed bubble-text-2 transition-opacity duration-500 opacity-0 absolute inset-0 p-5 pointer-events-none">
        Bạn đã sẵn sàng để xây dựng dự án mới?
      </p>
      <svg class="absolute -left-3 top-4" width="16" height="24" viewBox="0 0 16 24" fill="none">
  <path d="M16 0 L0 12 L16 24 Z" fill="rgba(255,255,255,0.6)"/>
</svg>
    </div>
  </div>

</section>

<style>
  :global(.hero) {
    overflow: hidden;
  }

  :global(.hero__bubble) {
    position: absolute;
    top: 15%;
    left: 50%;
    margin-left: 140px; 
    transform: rotate(-3deg);
    max-width: 280px;
  }

  :global(.hero__fan) {
    position: absolute;
    bottom: 70px; 
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 400px;
    perspective: 1000px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.fan-card) {
    position: absolute;
    width: 240px;
    height: 330px;
    left: 50%;
    top: 50%;
    margin-left: -120px;
    margin-top: -165px;
    cursor: pointer;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    user-select: none;
    transition: transform 0.5s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.5s ease;
  }

  :global(.fan-card .card) {
    width: 100%;
    height: 100%;
  }

  :global(.fan-navi) {
    position: absolute;
    bottom: 108px; 
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 12;
    pointer-events: none;
  }

  :global(.fan-navi__prev),
  :global(.fan-navi__next) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #593B34;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.2s, transform 0.2s;
  }

  :global(.fan-navi__prev:hover),
  :global(.fan-navi__next:hover) {
    opacity: 0.85;
    transform: scale(1.08);
  }

  :global(.fan-navi__prev .icn),
  :global(.fan-navi__next .icn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 8px;
  }

  :global(.hero *) {
   -webkit-tap-highlight-color: transparent;
   outline: none;
  }

  :global(.fan-navi__prev .icn svg) {
    transform: scaleX(-1);
  }

  :global(.fan-navi__next .icn svg) {
    transform: scaleX(1);
  }

  @media (max-width: 1023px) {
     .hero {
        min-height: 1400px;
     }
  }

  @media (max-width: 767px) {
    .hero {
        min-height: 1200px;
    }
    :global(.fan-card) {
      width: 200px;
      height: 280px;
      margin-left: -100px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const fanEl = document.getElementById('heroFan');
  if (!fanEl) return;

  const cards = Array.from(fanEl.querySelectorAll('.fan-card')) as HTMLElement[];
  if (cards.length === 0) return;

  const N = cards.length;
  let currentIndex = 0; // card đang active
  let startX = 0;
  let dragging = false;

  function applyLayout(index: number) {
    cards.forEach((el, i) => {
      const offset = i - index;
      // Xử lý vòng lặp: tìm khoảng cách ngắn nhất
      let d = offset;
      if (d > N / 2) d -= N;
      if (d < -N / 2) d += N;

      const translateX = d * 220;
      const rotateY = d * -45;
      const scale = d === 0 ? 1 : 0.75;
      const opacity = Math.abs(d) > 1 ? 0 : 1;
      const zIndex = N - Math.abs(d);

      el.style.transform = `translateX(${translateX}px) rotateY(${rotateY}deg) scale(${scale})`;
      el.style.opacity = opacity.toString();
      el.style.zIndex = zIndex.toString();
    });
  }

  // Click vào card
  cards.forEach((el, i) => {
    el.addEventListener('click', () => {
      currentIndex = i;
      applyLayout(currentIndex);
    });
  });

  // Nút prev/next
  document.getElementById('fanPrev')?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + N) % N;
    applyLayout(currentIndex);
  });

  document.getElementById('fanNext')?.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % N;
    applyLayout(currentIndex);
  });

  // Drag/swipe
  fanEl.addEventListener('pointerdown', e => {
    e.preventDefault(); 
    dragging = true;
    startX = e.clientX;
    fanEl.setPointerCapture(e.pointerId);
  });

  fanEl.addEventListener('pointerup', e => {
    if (!dragging) return;
    dragging = false;
    const diff = e.clientX - startX;
    if (Math.abs(diff) > 50) {
      if (diff < 0) {
        currentIndex = (currentIndex + 1) % N;
      } else {
        currentIndex = (currentIndex - 1 + N) % N;
      }
    }
    applyLayout(currentIndex);
  });

  applyLayout(0);

  // Bubble text crossfade
  const text1 = document.querySelector('.bubble-text-1') as HTMLElement;
  const text2 = document.querySelector('.bubble-text-2') as HTMLElement;
  let isText1 = true;
  if (text1 && text2) {
    setInterval(() => {
      isText1 = !isText1;
      text1.style.opacity = isText1 ? '1' : '0';
      text2.style.opacity = isText1 ? '0' : '1';
    }, 4000);
  }
});
</script>