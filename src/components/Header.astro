---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: `/${lang}`, label: t('nav.home') },
  { href: `/${lang}/about`, label: t('nav.about') },
  { href: `/${lang}/projects`, label: t('nav.projects') },
  { href: `/${lang}/contact`, label: t('nav.contact') },
];
---

<div class="header-wrap fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <div class="header-container" id="headerContainer">

    <!-- Rope left -->
    <div class="rope rope-left absolute bottom-full pointer-events-none">
      <img src="/images/rope.png" alt="">
    </div>

    <!-- Rope right -->
    <div class="rope rope-right absolute bottom-full pointer-events-none">
      <img src="/images/rope.png" alt="">
    </div>

    <!-- Board -->
    <div class="board pointer-events-auto relative rounded-b-2xl px-8 h-16 flex items-center gap-8"
         style="background-color: rgba(243, 228, 210, 0.92); backdrop-filter: blur(12px); border: 1px solid rgba(89,59,52,0.12); border-top: none; box-shadow: 0 8px 32px rgba(89,59,52,0.15);">

      <a href={`/${lang}`} class="text-lg font-black tracking-tighter text-brand-text flex items-center gap-2 whitespace-nowrap">
        <span class="w-7 h-7 bg-brand-primary rounded-full flex items-center justify-center text-white text-xs">H</span>
        Phạm Quốc Hưng
      </a>

      <nav class="hidden md:flex items-center gap-1">
        {navItems.map((item, index) => (
          <span class="flex items-center">
            <a href={item.href} class="px-3 py-1 text-sm font-bold text-brand-text hover:text-brand-primary transition-colors whitespace-nowrap">
              {item.label}
            </a>
            {index < navItems.length - 1 && (
              <span class="w-px h-4 bg-brand-text/10"></span>
            )}
          </span>
        ))}
      </nav>

      <div class="pl-4 border-l border-brand-text/10">
        <LanguageSwitcher />
      </div>

    </div>

  </div>
</div>

<style>
  .header-container {
  transform-origin: center -100px; /* âm = lên trên, bằng chiều cao rope */
  transform: rotateX(-90deg);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.34, 1.5, 0.64, 1),
              opacity 0s 0.7s;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.header-container.is-visible {
  transform: rotateX(0deg);
  opacity: 1;
  transition: transform 0.7s cubic-bezier(0.34, 1.5, 0.64, 1),
              opacity 0s 0s;
}

  .header-wrap {
  overflow: visible !important;
  perspective: 600px;
  perspective-origin: top center;
  padding-top: 30px;
}

  .rope {
    width: 32px;
    transform-origin: top center;
  }

  .rope-left {
    left: 20%;
  }

  .rope-right {
    right: 20%;
  }

  .rope img {
    width: 100%;
    height: auto;
  }

  .header-container.is-visible .rope {
  animation: ropeSwing 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes ropeSwing {
  0%   { transform: rotate(-6deg); }
  40%  { transform: rotate(4deg); }
  70%  { transform: rotate(-2deg); }
  90%  { transform: rotate(1deg); }
  100% { transform: rotate(0deg); }
}
</style>

<script>
  const container = document.getElementById('headerContainer') as HTMLElement;
let lastScrollY = window.scrollY;
let scrollTimer: ReturnType<typeof setTimeout> | null = null;

window.addEventListener('scroll', () => {
  const currentScrollY = window.scrollY;
  const scrollingUp = currentScrollY < lastScrollY;

  if (scrollTimer) clearTimeout(scrollTimer);

  if (currentScrollY < 20) {
    container?.classList.remove('is-visible');
  } else if (scrollingUp) {
    container?.classList.add('is-visible');
    // Ẩn sau 2 giây nếu không scroll tiếp
    scrollTimer = setTimeout(() => {
      container?.classList.remove('is-visible');
    }, 2000);
  }

  lastScrollY = currentScrollY;
});
</script>